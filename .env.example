# ========================================
# HRMS Backend - Environment Configuration
# ========================================
# Copy to .env and fill in real values. Never commit .env.

# ========================================
# Server Configuration
# ========================================
NODE_ENV=development
PORT=5001

# Backend URL (Optional - auto-detected based on NODE_ENV)
# BACKEND_URL=https://your-api.example.com

# ========================================
# Database Configuration
# ========================================
MONGODB_URI=mongodb://localhost:27017/hrms_main

# ========================================
# JWT / Encryption (REQUIRED)
# ========================================
JWT_SECRET=replace_with_long_random_secret
# JWT_EXPIRES_IN=7d
# ENCRYPTION_KEY=replace_with_64_char_hex
# ENCRYPTION_ALGORITHM=aes-256-gcm

# ========================================
# CORS Configuration (REQUIRED in production)
# ========================================
# Comma-separated allowlist only — no wildcards
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Production example:
# FRONTEND_URL=https://hrms.yourdomain.com
# CORS_ORIGIN=https://hrms.yourdomain.com

# Public registration is OFF in production unless explicitly enabled
# ENABLE_PUBLIC_REGISTER=false

# ========================================
# AI Configuration (optional — leave empty to disable)
# ========================================
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v3
# DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MAX_TOKENS=4096
# DEEPSEEK_TEMPERATURE=0.7
# OPENAI_API_KEY=
# REDUCTO_API_KEY=

# ========================================
# Email Configuration
# ========================================
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ========================================
# Redis (recommended in production for token blacklist / logout)
# ========================================
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ========================================
# Google Sheets (optional)
# ========================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5001/api/employees/google-sheets/callback

# ========================================
# AWS S3 (resume / document storage)
# ========================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name

# ========================================
# Bootstrap (local / first setup only — change immediately)
# ========================================
# SUPER_ADMIN_EMAIL=superadmin@example.com
# SUPER_ADMIN_PASSWORD=replace_me
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Destructive seed scripts require ALLOW_WIPE=1 and refuse NODE_ENV=production
# ALLOW_WIPE=0
